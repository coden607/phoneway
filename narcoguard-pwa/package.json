{
  "name": "narcoguard-pwa",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Public PWA demo and early wearable concept for overdose-prevention research and community response",
  "license": "MIT",
  "author": "Stephen Blanford <narcoguard607@gmail.com>",
  "scripts": {
    "build": "node scripts/run-next-build.js",
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "test:pwa": "node scripts/run-pwa-tests.js",
    "verify": "npm run lint && npm run validate:production && npm run validate:env && npm run typecheck && npm run validate:supabase && npm run validate:claims && npm run test:signals && npm run test:vitals && npm run test:guardian && npm run test:constitution && npm run test:features && npm run validate:watch-design && npm run audit:deps && npm run build && npm run test:pwa",
    "health": "npm run verify",
    "setup:project-ops": "node scripts/setup-project-ops.mjs",
    "marketing:run": "node scripts/post-daily-campaign.js",
    "marketing:buffer": "node scripts/push-buffer-campaign.js",
    "marketing:videos": "bash scripts/generate-tiktok-videos.sh",
    "start": "next start",
    "validate:supabase": "node scripts/validate-supabase.js",
    "validate:claims": "node scripts/validate-claims.js",
    "test:signals": "node --import tsx scripts/test-signal-fusion.ts",
    "test:guardian": "node --import tsx --test tests/guardian-*.test.ts tests/prevention-engine.test.ts",
    "test:constitution": "node --import tsx --test tests/constitution-page.test.tsx",
    "validate:watch-design": "node --import tsx scripts/validate-watch-design.ts",
    "validate:production": "node scripts/validate-production.js",
    "validate:env": "node scripts/validate-env.js",
    "test:vitals": "node --import tsx --test tests/vitals-response.test.ts",
    "test:features": "node --import tsx --test tests/feature-*.test.ts",
    "audit:deps": "node scripts/audit-gate.js"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23",
      "sharp": "0.35.5"
    }
  },
  "dependencies": {
    "@emotion/is-prop-valid": "1.4.0",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^14.0.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.3.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
